# Порт на HTTP сървъра
PORT=3000

# AI доставчик: none (само правила) | mock (примерен отговор, без мрежа) | anthropic
AI_PROVIDER=none

# Нужни само при AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_TIMEOUT_MS=5000

# Само за демонстрация с AI_PROVIDER=mock: симулира недостъпна AI услуга
MOCK_AI_FAIL=false
